{
  "appId": "com.betvision.cienxbajo",
  "appName": "BetVision",
  "webDir": "www",
  "backgroundColor": "#0B0E14",
  "server": {
    "url": "https://betvision-grsh.onrender.com",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "scheme": "BetVision",
